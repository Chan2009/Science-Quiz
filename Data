<style>
  :root { --p: #2563eb; --g: #16a34a; --r: #dc2626; --n: #f59e0b; }
  * { box-sizing: border-box; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; margin:0; padding:0; }
  body { background:#f8fafc; padding:1rem; max-width:900px; margin:0 auto; }
