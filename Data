let current = 0, score = 0, answered = {}, timeLeft = 75*60, timer;
let history = JSON.parse(localStorage.getItem('quizHistory')||'[]');

function render(){
  const c = questions[current];
  const cont = document.getElementById('quizContainer');
  cont.innerHTML = `<div class="q-card active">
    <div class="q-num">Question ${current+1} of ${questions.length}</div>
    <div class="q-text">${c.text}</div>
    <div class="opts">${c.opts.map((o,i)=>{
      let cl='opt';
      if(answered[current]!==undefined){
        const chosen = answered[current];
        const chosenLetter = chosen;
        const optLetter = o.charAt(0);
        if(optLetter===c.ans) cl+=' correct disabled';
        else if(optLetter===chosenLetter) cl+=' wrong disabled';
        else cl+=' disabled';
      }
      return `<div class="${cl}" data-opt="${o[0]}" onclick="pick('${o[0]}')">${o}</div>`;
    }).join('')}</div>
    <div class="feed ${answered[current]!==undefined?'show':''} ${answered[current]===c.ans?'correct':'wrong'}" id="feed">
      ${answered[current]===c.ans?'✅ Correct!':'❌ Wrong. Answer: '+c.ans} — ${c.exp}
    </div>
  </div>`;
  updateNav();
  document.getElementById('progBar').style.width = ((current+1)/questions.length*100)+'%';
}

function pick(letter){
  if(answered[current]!==undefined) return;
  answered[current] = letter;
  render();
}

function updateNav(){
  document.getElementById('prevBtn').style.visibility = current>0?'visible':'hidden';
  document.getElementById('nextBtn').style.display = current<questions.length-1?'inline-block':'none';
  document.getElementById('finishBtn').style.display = current===questions.length-1?'inline-block':'none';
}

function goPrev(){ if(current>0){ current--; render(); } }
function goNext(){ if(current<questions.length-1){ current++; render(); } }

function showResult(){
  clearInterval(timer);
  score = Object.entries(answered).filter(([k,v])=>questions[+k].ans===v).length;
  const pct = Math.round(score/questions.length*100);
  let grade='',desc='';
  if(pct>=80){ grade='🌟 Excellent!'; desc='Strong mastery of Form 4 & 5 Science'; }
  else if(pct>=60){ grade='👍 Good'; desc='Keep revising to improve further'; }
  else if(pct>=40){ grade='📖 Fair'; desc='Spend more time on weak topics'; }
  else { grade='💪 Keep Going!'; desc='Review notes & try again'; }
  
  history.push({date:new Date().toLocaleString(), score:score, pct:pct});
  localStorage.setItem('quizHistory', JSON.stringify(history));
  
  document.getElementById('quizContainer').style.display='none';
  document.querySelector('.nav').style.display='none';
  document.getElementById('resultCard').style.display='block';
  document.getElementById('finalScore').innerHTML = `${score} / ${questions.length}<br>${pct}%`;
  document.getElementById('gradeText').textContent = grade;
  document.getElementById('gradeDesc').textContent = desc;
  
  renderHistory();
}

