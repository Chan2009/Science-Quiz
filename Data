  .opt:hover { border-color:var(--p); background:#eff6ff; }
  .opt.correct { border-color:var(--g); background:#f0fdf4; font-weight:bold; }
  .opt.wrong { border-color:var(--r); background:#fef2f2; }
  .opt.disabled { pointer-events:none; opacity:.7; }
  .feed { margin-top:.8rem; padding:.75rem; border-radius:6px; display:none; font-size:0.9rem; }
  .feed.show { display:block; }
  .feed.correct { background:#f0fdf4; color:#166534; border-left:4px solid var(--g); }
  .feed.wrong { background:#fef2f2; color:#991b1b; border-left:4px solid var(--r); }
  .nav { display:flex; justify-content:space-between; margin:1.5rem 0; flex-wrap:wrap; gap:.5rem; }
  button { padding:.7rem 1.2rem; border:none; border-radius:8px; font-size:0.95rem; cursor:pointer; }
  .btn-primary { background:var(--p); color:white; }
  .btn-secondary { background:#e2e8f0; color:#334155; }
  .result-card { background:white; border-radius:12px; padding:2rem; text-align:center; display:none; box-shadow:0 4px 12px #0002; }
  .score { font-size:2.2rem; font-weight:bold; margin:1rem 0; }
  .grade { font-size:1.1rem; margin-bottom:1rem; }
  .history { margin-top:2rem; background:white; border-radius:12px; padding:1rem; display:none; }
  .history h3 { margin-bottom:.8rem; font-size:1rem; }
  .history-item { padding:.5rem; border-bottom:1px solid #eee; font-size:0.9rem; }
</style>
</head>
