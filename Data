  .timer { font-weight:bold; color:var(--r); font-size:1rem; }
  .progress { height:8px; background:#e2e8f0; border-radius:4px; margin-bottom:1rem; overflow:hidden; }
  .prog-bar { height:100%; background:var(--p); width:0; transition:width .3s; }
  .q-card { background:white; border-radius:12px; padding:1.2rem; margin-bottom:1rem; box-shadow:0 2px 8px #0001; display:none; }
